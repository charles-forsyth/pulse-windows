<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Pulse.Views.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Pulse.Controls"
    NavigationCacheMode="Required">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32,20,32,32" MaxWidth="1600">
            <!-- Header -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Overview" Style="{StaticResource PageTitle}" />
                    <TextBlock x:Name="Subtitle" Style="{StaticResource Caption}" Margin="0,4,0,0" Text="Collecting live telemetry…" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="24" VerticalAlignment="Bottom">
                    <StackPanel>
                        <TextBlock Text="UPTIME" Style="{StaticResource Caption}" FontSize="10" CharacterSpacing="80" />
                        <TextBlock x:Name="UptimeText" Text="—" FontSize="15" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="PROCESSES" Style="{StaticResource Caption}" FontSize="10" CharacterSpacing="80" />
                        <TextBlock x:Name="ProcText" Text="—" FontSize="15" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="THREADS" Style="{StaticResource Caption}" FontSize="10" CharacterSpacing="80" />
                        <TextBlock x:Name="ThreadText" Text="—" FontSize="15" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="HANDLES" Style="{StaticResource Caption}" FontSize="10" CharacterSpacing="80" />
                        <TextBlock x:Name="HandleText" Text="—" FontSize="15" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Gauges -->
            <c:AdaptiveGrid x:Name="GaugeGrid" Balanced="True" MinItemWidth="250" Spacing="16" MaxColumns="4">
                <Border Style="{StaticResource Card}" x:Name="CpuCard">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="84" Height="84">
                            <c:RingGauge x:Name="CpuGauge" Thickness="8" />
                            <TextBlock x:Name="CpuGaugeText" Text="0%" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <FontIcon Glyph="&#xE950;" FontSize="12" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,4" Opacity="0.6" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Processor" Style="{StaticResource CardTitle}" />
                            <TextBlock x:Name="CpuValue" Text="—" Style="{StaticResource BigValue}" FontSize="24" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            <TextBlock x:Name="CpuDetail" Text="" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" x:Name="MemCard">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="84" Height="84">
                            <c:RingGauge x:Name="MemGauge" Thickness="8" />
                            <TextBlock x:Name="MemGaugeText" Text="0%" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <FontIcon Glyph="&#xE964;" FontSize="12" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,4" Opacity="0.6" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Memory" Style="{StaticResource CardTitle}" />
                            <TextBlock x:Name="MemValue" Text="—" Style="{StaticResource BigValue}" FontSize="24" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            <TextBlock x:Name="MemDetail" Text="" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" x:Name="DiskCard">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="84" Height="84">
                            <c:RingGauge x:Name="DiskGauge" Thickness="8" />
                            <TextBlock x:Name="DiskGaugeText" Text="0%" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <FontIcon Glyph="&#xEDA2;" FontSize="12" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,4" Opacity="0.6" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Disk activity" Style="{StaticResource CardTitle}" />
                            <TextBlock x:Name="DiskValue" Text="—" Style="{StaticResource BigValue}" FontSize="24" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            <TextBlock x:Name="DiskDetail" Text="" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" x:Name="NetCard">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="84" Height="84">
                            <c:RingGauge x:Name="NetGauge" Thickness="8" />
                            <TextBlock x:Name="NetGaugeText" Text="0%" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <FontIcon Glyph="&#xE968;" FontSize="12" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,4" Opacity="0.6" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Network" Style="{StaticResource CardTitle}" />
                            <TextBlock x:Name="NetValue" Text="—" Style="{StaticResource BigValue}" FontSize="24" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            <TextBlock x:Name="NetDetail" Text="" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </StackPanel>
                    </Grid>
                </Border>
            </c:AdaptiveGrid>

            <!-- Charts -->
            <c:AdaptiveGrid x:Name="ChartGrid" MinItemWidth="420" Spacing="16" MaxColumns="2" Margin="0,16,0,0">
                <Border Style="{StaticResource Card}" c:AdaptiveGrid.Span="2">
                    <StackPanel Spacing="12">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="CPU utilisation" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="last 60 samples" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="CpuChartValue" HorizontalAlignment="Right" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </Grid>
                        <c:Sparkline x:Name="CpuChart" Height="170" FixedMax="100" />
                        <TextBlock x:Name="CoresLabel" Text="Logical processors" Style="{StaticResource Caption}" />
                        <c:CoreBars x:Name="Cores" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="12">
                        <Grid>
                            <TextBlock Text="Memory in use" Style="{StaticResource CardTitle}" />
                            <TextBlock x:Name="MemChartValue" HorizontalAlignment="Right" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </Grid>
                        <c:Sparkline x:Name="MemChart" Height="140" FixedMax="100" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Available" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="MemAvail" Text="—" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Committed" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="MemCommit" Text="—" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Cached" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="MemCache" Text="—" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="12">
                        <Grid>
                            <TextBlock Text="Disk throughput" Style="{StaticResource CardTitle}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse x:Name="DiskReadDot" Width="8" Height="8" VerticalAlignment="Center" />
                                    <TextBlock x:Name="DiskReadText" Text="Read —" Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse x:Name="DiskWriteDot" Width="8" Height="8" VerticalAlignment="Center" />
                                    <TextBlock x:Name="DiskWriteText" Text="Write —" Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <c:Sparkline x:Name="DiskChart" Height="140" />
                        <TextBlock x:Name="DiskNote" Style="{StaticResource Caption}" Text="Physical disks, all volumes" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" c:AdaptiveGrid.Span="2">
                    <StackPanel Spacing="12">
                        <Grid>
                            <TextBlock Text="Network throughput" Style="{StaticResource CardTitle}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse x:Name="NetDownDot" Width="8" Height="8" VerticalAlignment="Center" />
                                    <TextBlock x:Name="NetDownText" Text="Down —" Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse x:Name="NetUpDot" Width="8" Height="8" VerticalAlignment="Center" />
                                    <TextBlock x:Name="NetUpText" Text="Up —" Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <c:Sparkline x:Name="NetChart" Height="140" />
                        <TextBlock x:Name="NetNote" Style="{StaticResource Caption}" Text="" />
                    </StackPanel>
                </Border>
            </c:AdaptiveGrid>
        </StackPanel>
    </ScrollViewer>
</Page>
