<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Pulse.Views.SystemPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Pulse.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32,20,32,32" MaxWidth="1400">
            <TextBlock Text="System" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,20" Text="Hardware and operating system inventory from WMI, the registry and Win32." />

            <!-- Hero -->
            <Border Style="{StaticResource Card}" Padding="24" x:Name="Hero">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="72" Height="72" CornerRadius="18">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#6D28D9" Offset="0" />
                                <GradientStop Color="#4F46E5" Offset="0.5" />
                                <GradientStop Color="#06B6D4" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <FontIcon Glyph="&#xE7F8;" FontSize="32" Foreground="White" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="HostName" Text="—" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="OsName" Text="Loading…" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="CpuName" Text="" Style="{StaticResource Caption}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="UPTIME" Style="{StaticResource Caption}" FontSize="10" CharacterSpacing="80" HorizontalAlignment="Right" />
                        <TextBlock x:Name="Uptime" Text="—" Style="{StaticResource BigValue}" HorizontalAlignment="Right" />
                        <TextBlock x:Name="BootTime" Text="" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
            </Border>

            <ProgressBar x:Name="Progress" IsIndeterminate="True" Margin="0,12,0,0" />

            <c:AdaptiveGrid x:Name="Cards" MinItemWidth="380" MaxColumns="3" Spacing="16" Margin="0,16,0,0">
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE770;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Operating system" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </StackPanel>
                        <StackPanel x:Name="OsRows" Spacing="0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE950;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Processor" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </StackPanel>
                        <StackPanel x:Name="CpuRows" Spacing="0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE977;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Device" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </StackPanel>
                        <StackPanel x:Name="MachineRows" Spacing="0" />
                    </StackPanel>
                </Border>
            </c:AdaptiveGrid>

            <TextBlock Text="Graphics" Style="{StaticResource SectionHeader}" />
            <c:AdaptiveGrid x:Name="GpuCards" MinItemWidth="380" MaxColumns="3" Spacing="16" />

            <TextBlock Text="Displays" Style="{StaticResource SectionHeader}" />
            <c:AdaptiveGrid x:Name="DisplayCards" MinItemWidth="300" MaxColumns="4" Spacing="16" />
        </StackPanel>
    </ScrollViewer>
</Page>
