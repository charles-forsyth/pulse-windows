<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Pulse.Views.ProcessesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Pulse.Views">

    <Grid Padding="32,20,32,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Processes" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="Summary" Style="{StaticResource Caption}" Margin="0,4,0,0" Text="Sampling processes…" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                <AutoSuggestBox x:Name="Search" Width="280" PlaceholderText="Search by name or PID" QueryIcon="Find"
                                TextChanged="Search_TextChanged" />
                <ToggleButton x:Name="PauseButton" Click="Pause_Click" ToolTipService.ToolTip="Pause updates">
                    <FontIcon x:Name="PauseIcon" Glyph="&#xE769;" FontSize="14" />
                </ToggleButton>
            </StackPanel>
        </Grid>

        <!-- Column header -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,6" CornerRadius="8">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="70" />
                </Grid.ColumnDefinitions>
                <HyperlinkButton Grid.Column="1" x:Name="HdrName" Content="Name" Tag="name" Click="Header_Click" Padding="4,2" />
                <HyperlinkButton Grid.Column="2" x:Name="HdrPid" Content="PID" Tag="pid" Click="Header_Click" Padding="4,2" HorizontalAlignment="Right" />
                <HyperlinkButton Grid.Column="3" x:Name="HdrCpu" Content="CPU" Tag="cpu" Click="Header_Click" Padding="4,2" HorizontalAlignment="Right" />
                <HyperlinkButton Grid.Column="4" x:Name="HdrMem" Content="Memory" Tag="mem" Click="Header_Click" Padding="4,2" HorizontalAlignment="Right" />
                <HyperlinkButton Grid.Column="5" x:Name="HdrPriv" Content="Private" Tag="priv" Click="Header_Click" Padding="4,2" HorizontalAlignment="Right" />
                <HyperlinkButton Grid.Column="6" x:Name="HdrThreads" Content="Threads" Tag="threads" Click="Header_Click" Padding="4,2" HorizontalAlignment="Right" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4">
            <Grid>
                <ListView x:Name="List" SelectionMode="Single" ItemsSource="{x:Bind Rows}" IsItemClickEnabled="False">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="Padding" Value="12,0" />
                            <Setter Property="MinHeight" Value="44" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:ProcRow">
                            <Grid ColumnSpacing="12" Height="44">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" CornerRadius="8" Background="{x:Bind Avatar, Mode=OneWay}" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Initial, Mode=OneWay}" Foreground="White" FontWeight="SemiBold" FontSize="13"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="{x:Bind Name, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{x:Bind PidText, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Right"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                                <Grid Grid.Column="3" ColumnSpacing="8" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="52" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Height="6" CornerRadius="3" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                                        <Border Height="6" CornerRadius="3" HorizontalAlignment="Left" Width="{x:Bind CpuBar, Mode=OneWay}"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}" />
                                    </Grid>
                                    <TextBlock Grid.Column="1" Text="{x:Bind CpuText, Mode=OneWay}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                </Grid>
                                <TextBlock Grid.Column="4" Text="{x:Bind MemText, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="5" Text="{x:Bind PrivText, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Right"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="6" Text="{x:Bind ThreadsText, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Right"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <ProgressRing IsActive="True" Width="36" Height="36" />
                    <TextBlock Text="Measuring per-process CPU…" Style="{StaticResource Caption}" />
                </StackPanel>
                <TextBlock x:Name="Empty" Text="No processes match your search." Visibility="Collapsed"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Caption}" />
            </Grid>
        </Border>
    </Grid>
</Page>
