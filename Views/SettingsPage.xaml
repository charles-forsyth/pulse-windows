<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Pulse.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <Style x:Key="SettingRow" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32,20,32,32" MaxWidth="1000" HorizontalAlignment="Stretch">
            <TextBlock Text="Settings" Style="{StaticResource PageTitle}" Margin="0,4,0,8" />

            <StackPanel x:Name="Sections">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition IsStaggeringEnabled="True" />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>

                <TextBlock Text="Appearance" Style="{StaticResource SectionHeader}" />

                <!-- Theme -->
                <Border Style="{StaticResource SettingRow}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE790;" FontSize="18" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="App theme" />
                            <TextBlock Text="Choose light, dark, or follow Windows" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <ComboBox x:Name="ThemeBox" Grid.Column="2" MinWidth="210" VerticalAlignment="Center" SelectionChanged="Theme_Changed">
                            <ComboBoxItem Content="Use system setting" Tag="System" />
                            <ComboBoxItem Content="Light" Tag="Light" />
                            <ComboBoxItem Content="Dark" Tag="Dark" />
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- Backdrop -->
                <Border Style="{StaticResource SettingRow}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE771;" FontSize="18" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Window material" />
                            <TextBlock Text="Mica tints the window with your desktop wallpaper" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <ComboBox x:Name="BackdropBox" Grid.Column="2" MinWidth="210" VerticalAlignment="Center" SelectionChanged="Backdrop_Changed">
                            <ComboBoxItem Content="Mica" Tag="Mica" />
                            <ComboBoxItem Content="Mica Alt" Tag="MicaAlt" />
                            <ComboBoxItem Content="Acrylic" Tag="Acrylic" />
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- Accent -->
                <Border Style="{StaticResource SettingRow}">
                    <StackPanel Spacing="14">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE2B1;" FontSize="18" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Accent colour" />
                                <TextBlock x:Name="AccentCaption" Text="Used for highlights, the CPU gauge and charts" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </Grid>
                        <GridView x:Name="AccentGrid" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="Accent_Click" Margin="34,0,0,0">
                            <GridView.ItemContainerStyle>
                                <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                                    <Setter Property="Margin" Value="0,0,6,6" />
                                </Style>
                            </GridView.ItemContainerStyle>
                        </GridView>
                    </StackPanel>
                </Border>

                <TextBlock Text="Monitoring" Style="{StaticResource SectionHeader}" />

                <!-- Refresh -->
                <Border Style="{StaticResource SettingRow}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE72C;" FontSize="18" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Refresh rate" />
                            <TextBlock Text="How often live metrics are sampled" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <ComboBox x:Name="RateBox" Grid.Column="2" MinWidth="210" VerticalAlignment="Center" SelectionChanged="Rate_Changed">
                            <ComboBoxItem Content="Fast (0.5 s)" Tag="0.5" />
                            <ComboBoxItem Content="Normal (1 s)" Tag="1" />
                            <ComboBoxItem Content="Relaxed (2 s)" Tag="2" />
                            <ComboBoxItem Content="Slow (5 s)" Tag="5" />
                        </ComboBox>
                    </Grid>
                </Border>

                <TextBlock Text="About" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource SettingRow}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Source="ms-appx:///Assets/Pulse.png" Width="40" Height="40" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Pulse" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="AboutText" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            <TextBlock x:Name="PathText" Style="{StaticResource Caption}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
